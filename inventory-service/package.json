{
  "name": "@travel/inventory-service",
  "version": "0.1.0",
  "private": true,
  "description": "Inventory / Flight Search Service — use npm install --no-package-lock",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest --forceExit --runInBand",
    "test:coverage": "jest --forceExit --runInBand --config jest.coverage.config.js",
    "migration:run": "ts-node -r tsconfig-paths/register node_modules/.bin/typeorm migration:run -d src/infrastructure/persistence/typeorm-data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register node_modules/.bin/typeorm migration:revert -d src/infrastructure/persistence/typeorm-data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/typeorm": "^10.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.46.1",
    "@opentelemetry/sdk-node": "^0.51.1",
    "@travel/shared": "file:../packages/shared",
    "@types/opossum": "^8.1.1",
    "axios": "^1.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.3.2",
    "joi": "^17.0.0",
    "kafkajs": "^2.0.0",
    "opossum": "^8.1.3",
    "pg": "^8.11.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@pact-foundation/pact": "^13.1.3",
    "@testcontainers/postgresql": "^10.9.0",
    "@testcontainers/redis": "^10.9.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^2.0.0",
    "axios-mock-adapter": "^1.22.0",
    "jest": "^29.0.0",
    "nock": "^13.5.4",
    "supertest": "^6.3.0",
    "testcontainers": "^10.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
