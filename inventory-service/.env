# inventory-service — LOCAL DEVELOPMENT (.env)
# Used when running the service directly on the host (not in Docker).
# For Docker, env vars are injected via docker-compose.yml.
# NEVER commit real Amadeus keys.

NODE_ENV=development
PORT=3005

# Database
DATABASE_URL=postgresql://admin:admin@localhost:5433/travel_portal

# Redis (TTL: 5min for flight search results)
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Amadeus Flight Search API — get test keys at https://developers.amadeus.com
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=REPLACE_WITH_YOUR_AMADEUS_CLIENT_ID
AMADEUS_CLIENT_SECRET=REPLACE_WITH_YOUR_AMADEUS_CLIENT_SECRET

# Reservation hold window (minutes)
RESERVATION_HOLD_MINUTES=15

# AES-256-CBC encryption key for passport numbers at rest (32 hex chars = 128-bit)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSPORT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
