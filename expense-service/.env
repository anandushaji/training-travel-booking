# expense-service — LOCAL DEVELOPMENT (.env)
# Used when running the service directly on the host (not in Docker).
# For Docker, env vars are injected via docker-compose.yml.

NODE_ENV=development
PORT=3006

# Database
DATABASE_URL=postgresql://admin:admin@localhost:5433/travel_portal

# Kafka (consumer for booking-events, producer for expense-events)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=expense-service
KAFKA_GROUP_ID=expense-service-consumer

# JWT — must match api-gateway JWT_SECRET for token validation
JWT_SECRET=dev-jwt-secret-change-in-production
