# policy-service — LOCAL DEVELOPMENT (.env)
# Used when running the service directly on the host (not in Docker).
# For Docker, env vars are injected via docker-compose.yml.

NODE_ENV=development
PORT=3002

# Database
DATABASE_URL=postgresql://admin:admin@localhost:5433/travel_portal

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=policy-service
KAFKA_GROUP_ID=policy-service-group

# Downstream service URLs
TRAVELER_SERVICE_URL=http://localhost:3003
TRAVELER_SERVICE_READ_TIMEOUT_MS=5000
TRAVELER_SERVICE_CONNECT_TIMEOUT_MS=2000
