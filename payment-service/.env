# payment-service — LOCAL DEVELOPMENT (.env)
# Used when running the service directly on the host (not in Docker).
# For Docker, env vars are injected via docker-compose.yml.
# NEVER commit real Stripe keys. Use test keys (sk_test_...) only.

NODE_ENV=development
PORT=3004

# Database — uses individual params (not DATABASE_URL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=travel_portal
DB_USER=admin
DB_PASSWORD=admin

# Stripe — replace with your actual test keys from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payment-service
KAFKA_GROUP_ID=payment-service-group
