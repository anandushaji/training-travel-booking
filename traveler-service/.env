# traveler-service — LOCAL DEVELOPMENT (.env)
# Used when running the service directly on the host (not in Docker).
# For Docker, env vars are injected via docker-compose.yml.

NODE_ENV=development
PORT=3003

# Database (uses default public schema — no schema override in TypeORM config)
DATABASE_URL=postgresql://admin:admin@localhost:5433/travel_portal

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# HR System (SOAP) — replace with real endpoint in production
HR_SYSTEM_URL=http://localhost:8090
HR_SYSTEM_USERNAME=admin
HR_SYSTEM_PASSWORD=admin
