{
  "name": "@travel/traveler-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest --forceExit --runInBand",
    "test:coverage": "jest --forceExit --runInBand --config jest.coverage.config.js",
    "migration:run": "ts-node -r tsconfig-paths/register node_modules/.bin/typeorm migration:run -d src/infrastructure/config/typeorm-data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register node_modules/.bin/typeorm migration:revert -d src/infrastructure/config/typeorm-data-source.ts",
    "migration:create": "ts-node -r tsconfig-paths/register node_modules/.bin/typeorm migration:create"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.39.0",
    "@opentelemetry/sdk-node": "^0.44.0",
    "@travel/shared": "file:../packages/shared",
    "bcryptjs": "^3.0.3",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.3.0",
    "joi": "^17.0.0",
    "kafkajs": "^2.0.0",
    "opossum": "^8.0.0",
    "pg": "^8.11.0",
    "prom-client": "^15.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/opossum": "^8.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^2.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "testcontainers": "^10.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
