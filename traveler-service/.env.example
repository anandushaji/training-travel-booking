# Traveler Service — Environment Variables

# PostgreSQL connection (required)
DATABASE_URL=postgres://postgres:password@localhost:5432/traveler_db

# Redis connection (required)
REDIS_URL=redis://localhost:6379

# Kafka broker list, comma-separated (required)
KAFKA_BROKERS=localhost:9092

# HR System SOAP endpoint (required)
HR_SYSTEM_URL=http://hr.example.com/soap

# HR System credentials (required)
HR_SYSTEM_USERNAME=hr_user
HR_SYSTEM_PASSWORD=hr_password

# Service port (optional, default 3003)
PORT=3003
