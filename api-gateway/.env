# api-gateway — LOCAL DEVELOPMENT (.env)
# Used when running the service directly on the host (not in Docker).
# For Docker, env vars are injected via docker-compose.yml.

NODE_ENV=development
PORT=4000

# JWT — must match across all services that validate tokens
JWT_SECRET=dev-jwt-secret-change-in-production

# Redis (rate limiting + idempotency store)
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3000

# Downstream service URLs (local dev)
BOOKING_SERVICE_URL=http://localhost:3001
POLICY_SERVICE_URL=http://localhost:3002
TRAVELER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_URL=http://localhost:3005
EXPENSE_SERVICE_URL=http://localhost:3006
