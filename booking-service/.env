# booking-service — LOCAL DEVELOPMENT (.env)
# Used when running the service directly on the host (not in Docker).
# For Docker, env vars are injected via docker-compose.yml.

NODE_ENV=development
PORT=3001

# Database — single PostgreSQL instance, booking_service schema
DATABASE_URL=postgresql://admin:admin@localhost:5433/travel_portal

# Kafka — host port for local dev
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=booking-service
KAFKA_GROUP_ID=booking-service-group

# Downstream service URLs (local dev ports)
POLICY_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3004

# Timeout overrides (ms) — defaults shown
POLICY_CONNECT_TIMEOUT_MS=2000
POLICY_READ_TIMEOUT_MS=5000
INVENTORY_CONNECT_TIMEOUT_MS=2000
INVENTORY_READ_TIMEOUT_MS=5000
PAYMENT_CONNECT_TIMEOUT_MS=2000
PAYMENT_READ_TIMEOUT_MS=5000
